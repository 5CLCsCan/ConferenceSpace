AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8090
AI_SERVICE_ENV=development
LOG_LEVEL=INFO

OPENROUTER_API_KEY=
AGENT_MODEL=google/gemini-2.5-flash-lite-preview-09-2025

BACKEND_API_BASE_URL=http://localhost:8080
IDENTITY_REQUEST_TIMEOUT_SECONDS=3
ALLOW_DEV_AUTH_BYPASS=false
DEV_AUTH_USER_ID=1
DEV_AUTH_USER_EMAIL=dev@local

REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/conferencespace

AUTH_CACHE_TTL_SECONDS=60
SESSION_TTL_MINUTES=30
TOOL_RESULT_TIMEOUT_SECONDS=90
CONTEXT_COMPACTION_THRESHOLD=0.70
KEEP_RECENT_EXCHANGES=12
DEBUG_DURABLE_CHECKPOINT=false
