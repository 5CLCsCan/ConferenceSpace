# Server Configuration
SERVER_PORT=8080
SERVER_ENV=development
AI_SERVICE_BASE_URL=http://localhost:8090
AI_SERVICE_TIMEOUT_SECONDS=180

GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_ENABLED=true

# File storage
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_LOCAL_BASE_PATH=./uploads/submissions
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=


# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=conferencespace
DB_SSLMODE=disable

# Testing/Development
# Admin token for bypassing authentication in tests (use X-Admin-Token header)
ADMIN_TOKEN=1234
AGENT_SERVICE_TOKEN=
