# Backend base URL the benchmarks target
BASE_URL=http://localhost:8080

# k6 load parameters
VUS=20
DURATION=30s

# Optional pre-supplied JWT. If empty, scripts/seed bootstrap via /auth/test-login.
AUTH_TOKEN=

# Dataset sizes for the seed tool
SEED_CONFERENCES=300
SEED_SUBMISSIONS_PER_CONFERENCE=50
SEED_REVIEWERS=500
SEED_REVIEWERS_PER_CONFERENCE=30
SEED_CONCURRENCY=8
SEED_DECLARED_CONFLICTS=100

# Set to 1 to also seed the Neo4j co-authorship graph during run.sh
SEED_GRAPH=0

# Neo4j connection for optional co-authorship graph seeding
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=conferencespace
SEED_AUTHORS=500
SEED_COAUTHOR_EDGES=4000

# Resource monitoring (CPU/RAM sampling during k6 phases)
# Auto-enabled for a local BASE_URL; set 0 to disable, 1 to force.
MONITOR=1
MONITOR_INTERVAL=2s
CONTAINERS=conferencespace-db,conferencespace-redis,conferencespace-neo4j
