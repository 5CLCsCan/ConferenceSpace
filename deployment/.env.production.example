# =============================================================================
# ConferenceSpace production runtime environment
# =============================================================================
# Copy this file to /opt/conferencespace/.env.production on the server and fill
# real values there. Do not import app secrets into GitHub.

# -----------------------------------------------------------------------------
# Images updated by GitHub Actions on each deploy
# -----------------------------------------------------------------------------
FRONTEND_IMAGE=ghcr.io/owner/conferencespace-frontend:latest
BACKEND_IMAGE=ghcr.io/owner/conferencespace-backend:latest
AI_SERVICE_IMAGE=ghcr.io/owner/conferencespace-ai-service:latest

# -----------------------------------------------------------------------------
# Public frontend gateway / Next.js server runtime
# -----------------------------------------------------------------------------
PUBLIC_API_BASE_URL=/api/backend
APP_BASE_URL=https://conference-space.com
BACKEND_API_BASE_URL=http://backend:8080
AI_SERVICE_BASE_URL=http://ai-service:8090
AI_SERVICE_ENABLED=true
CORS_ALLOWED_ORIGINS=https://conference-space.com,https://www.conference-space.com
JWT_EXPIRY_SECONDS=86400

# -----------------------------------------------------------------------------
# Shared service-to-service authentication
# -----------------------------------------------------------------------------
AGENT_SERVICE_TOKEN=change-me

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=conferencespace
# Keep DB_* and POSTGRES_DSN in sync with POSTGRES_* above.
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=conferencespace
DB_SSLMODE=disable
POSTGRES_DSN=postgresql+asyncpg://postgres:change-me@postgres:5432/conferencespace
POSTGRES_SCHEMA=ai

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Neo4j
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_ENABLED=true
NEO4J_HEAP_INITIAL=256m
NEO4J_HEAP_MAX=512m
NEO4J_PAGECACHE=256m

# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------
SERVER_PORT=8080
SERVER_ENV=production
JWT_SECRET=change-me
JWT_EXPIRY_HOURS=24
ADMIN_TOKEN=
REQUIRE_EMAIL_VERIFICATION=false
AI_SERVICE_TIMEOUT_SECONDS=180

# Backend file storage. Keep local storage unless you intentionally configure
# Supabase object storage.
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_LOCAL_BASE_PATH=/data/uploads/submissions
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Backend external integrations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
GEMINI_ENABLED=true
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_ENABLED=true
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@conferencespace.io
BREVO_FROM_NAME=ConferenceSpace

# -----------------------------------------------------------------------------
# AI service
# -----------------------------------------------------------------------------
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8090
AI_SERVICE_ENV=production
LOG_LEVEL=INFO

OPENROUTER_API_KEY=
AGENT_MODEL=openrouter/google/gemini-2.5-flash-lite
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
LLM_REQUEST_TIMEOUT_SECONDS=60

IDENTITY_REQUEST_TIMEOUT_SECONDS=3
AUTH_CACHE_TTL_SECONDS=60
BACKEND_QUERY_TIMEOUT_SECONDS=10

SESSION_TTL_MINUTES=30
TOOL_RESULT_TIMEOUT_SECONDS=90
MAX_ITERATIONS=6
MAX_TURN_DURATION_SECONDS=120
CONTEXT_COMPACTION_THRESHOLD=0.70
KEEP_RECENT_EXCHANGES=12

MAX_MESSAGES_PER_REQUEST=200
MAX_MESSAGE_TEXT_CHARS=20000
MAX_CHAT_REQUESTS_PER_MINUTE=60
MAX_TOOL_RESULT_REQUESTS_PER_MINUTE=120
ENABLE_REASONING_STREAM=true
