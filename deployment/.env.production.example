# Images are set by the GitHub Actions deployment workflow.
FRONTEND_IMAGE=ghcr.io/OWNER/conferencespace-frontend:latest
BACKEND_IMAGE=ghcr.io/OWNER/conferencespace-backend:latest
AI_SERVICE_IMAGE=ghcr.io/OWNER/conferencespace-ai-service:latest

# Only this port is exposed on the host.
FRONTEND_PORT=3000
PUBLIC_API_BASE_URL=/api/backend
APP_BASE_URL=http://SERVER_IP:3000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=conferencespace

NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_HEAP_INITIAL=256m
NEO4J_HEAP_MAX=512m
NEO4J_PAGECACHE=256m

SERVER_ENV=production
JWT_SECRET=change-me
ADMIN_TOKEN=
AGENT_SERVICE_TOKEN=change-me

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
GEMINI_ENABLED=true

OPENROUTER_API_KEY=
AGENT_MODEL=openrouter/google/gemini-2.5-flash-lite
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

SEMANTIC_SCHOLAR_API_KEY=
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@conferencespace.io
BREVO_FROM_NAME=ConferenceSpace

FILE_STORAGE_PROVIDER=local
FILE_STORAGE_LOCAL_BASE_PATH=/data/uploads/submissions
AI_SERVICE_BASE_URL=http://ai-service:8090
AI_SERVICE_TIMEOUT_SECONDS=180
BACKEND_API_BASE_URL=http://backend:8080
REDIS_URL=redis://redis:6379/0
